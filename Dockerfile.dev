FROM hexpm/elixir:1.15.7-erlang-26.2.1-debian-bookworm-20231009-slim

# Install build dependencies
RUN apt-get update -y && apt-get install -y \
    build-essential \
    git \
    curl \
    inotify-tools \
    postgresql-client \
    && apt-get clean && rm -f /var/lib/apt/lists/*_*

# Install Node.js (required for esbuild and tailwind)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -f /var/lib/apt/lists/*_*

# Set working directory
WORKDIR /app

# Install hex and rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Copy mix files and install dependencies
COPY mix.exs mix.lock ./
RUN mix deps.get

# Copy config files
COPY config ./config

# Install assets dependencies (esbuild, tailwind)
RUN mix assets.setup

# Copy the rest of the application
COPY . .

# Compile dependencies
RUN mix deps.compile

# Expose Phoenix port
EXPOSE 4000

# Start Phoenix server
CMD ["mix", "phx.server"]
